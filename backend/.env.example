# LANDVAULT AI — backend environment template
# Copy to backend/.env and fill in real values. NEVER commit backend/.env.

# --- Security (REQUIRED) ---
# Generated automatically by scripts/init_db.py if missing.
SECRET_KEY=

# --- Database ---
# Local SQLite (default — no config needed):
# DATABASE_URL=sqlite:///data/landvault.db
#
# Supabase Postgres — Project Settings → Database → Connection string → URI.
# Use the pooler URI (port 6543) and replace [YOUR-PASSWORD]:
# DATABASE_URL=postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require

# --- Application ---
# CORS_ORIGINS=["http://localhost:5173"]
# MAX_UPLOAD_MB=25
# DATA_GOV_IN_API_KEY=
